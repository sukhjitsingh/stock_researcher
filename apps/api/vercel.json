{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && bun install",

  "buildCommand": "bun run build && mkdir -p public && echo 'Stock Researcher API' > public/index.html",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/weekly-scan", "schedule": "0 14 * * 1" }
  ]
}
