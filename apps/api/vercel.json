{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && bun install",
  "bunVersion": "1.x",
  "buildCommand": "bun run build",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/weekly-scan", "schedule": "0 14 * * 1" }
  ]
}
