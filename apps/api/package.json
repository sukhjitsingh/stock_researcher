    "zod": "^3.23.0",
    "yahoo-finance2": "^3.0.0",
    "@stock-researcher/shared": "workspace:*",
    "@stock-researcher/db": "workspace:*"
  },
  "devDependencies": {
    "@stock-researcher/eslint-config": "workspace:*",
    "@stock-researcher/typescript-config": "workspace:*",
