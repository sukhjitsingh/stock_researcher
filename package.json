{
  "name": "stock-researcher",
  "version": "5.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@stock-researcher/api",
    "dev:web": "turbo dev --filter=@stock-researcher/web",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "turbo db:generate --filter=@stock-researcher/db",
    "db:push": "turbo db:push --filter=@stock-researcher/db",
    "db:studio": "turbo db:studio --filter=@stock-researcher/db"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "bun@1.1.0"
}
